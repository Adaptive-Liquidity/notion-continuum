{
  "$ref": "#/definitions/EvidenceEvent",
  "definitions": {
    "EvidenceEvent": {
      "type": "object",
      "properties": {
        "v": {
          "type": "number",
          "const": 1
        },
        "event_id": {
          "type": "string",
          "pattern": "^evt_[0-9A-HJKMNP-TV-Z]{26}$"
        },
        "tenant_id": {
          "type": "string",
          "pattern": "^ten_[0-9A-HJKMNP-TV-Z]{26}$"
        },
        "seq": {
          "type": "integer"
        },
        "kind": {
          "type": "string",
          "enum": [
            "DECISION",
            "EFFECT",
            "RECEIPT",
            "APPROVAL",
            "REVOCATION",
            "RECOVERY",
            "ALERT",
            "EGRESS_DENIED"
          ]
        },
        "subject": {
          "type": "object",
          "properties": {
            "principal_id": {
              "type": "string",
              "pattern": "^prn_[0-9A-HJKMNP-TV-Z]{26}$"
            },
            "operation_id": {
              "type": "string",
              "pattern": "^op_[0-9A-HJKMNP-TV-Z]{26}$"
            },
            "authority_id": {
              "type": "string",
              "pattern": "^grt_[0-9A-HJKMNP-TV-Z]{26}$"
            }
          },
          "additionalProperties": false
        },
        "body_digest": {
          "type": "string"
        },
        "prev_hash": {
          "type": "string"
        },
        "hash": {
          "type": "string"
        },
        "at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "v",
        "event_id",
        "tenant_id",
        "seq",
        "kind",
        "subject",
        "body_digest",
        "prev_hash",
        "hash",
        "at"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
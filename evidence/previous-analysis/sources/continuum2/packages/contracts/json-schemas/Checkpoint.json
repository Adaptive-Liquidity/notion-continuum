{
  "$ref": "#/definitions/Checkpoint",
  "definitions": {
    "Checkpoint": {
      "type": "object",
      "properties": {
        "v": {
          "type": "number",
          "const": 1
        },
        "checkpoint_id": {
          "type": "string",
          "pattern": "^chk_[0-9A-HJKMNP-TV-Z]{26}$"
        },
        "tenant_id": {
          "type": "string",
          "pattern": "^ten_[0-9A-HJKMNP-TV-Z]{26}$"
        },
        "staxion_id": {
          "type": "string",
          "pattern": "^stx_[0-9A-HJKMNP-TV-Z]{26}$"
        },
        "kind": {
          "type": "string",
          "enum": [
            "COORDINATOR",
            "COMPUTER"
          ]
        },
        "task_id": {
          "type": "string",
          "pattern": "^tsk_[0-9A-HJKMNP-TV-Z]{26}$"
        },
        "object_ref": {
          "type": "string"
        },
        "at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "v",
        "checkpoint_id",
        "tenant_id",
        "staxion_id",
        "kind",
        "at"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
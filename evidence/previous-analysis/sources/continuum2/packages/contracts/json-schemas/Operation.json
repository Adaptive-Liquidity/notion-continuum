{
  "$ref": "#/definitions/Operation",
  "definitions": {
    "Operation": {
      "type": "object",
      "properties": {
        "v": {
          "type": "number",
          "const": 1
        },
        "operation_id": {
          "type": "string",
          "pattern": "^op_[0-9A-HJKMNP-TV-Z]{26}$"
        },
        "tenant_id": {
          "type": "string",
          "pattern": "^ten_[0-9A-HJKMNP-TV-Z]{26}$"
        },
        "staxion_id": {
          "type": "string",
          "pattern": "^stx_[0-9A-HJKMNP-TV-Z]{26}$"
        },
        "principal_id": {
          "type": "string",
          "pattern": "^prn_[0-9A-HJKMNP-TV-Z]{26}$"
        },
        "principal_epoch": {
          "type": "integer"
        },
        "task_id": {
          "type": "string",
          "pattern": "^tsk_[0-9A-HJKMNP-TV-Z]{26}$"
        },
        "execution_id": {
          "type": "string",
          "pattern": "^exe_[0-9A-HJKMNP-TV-Z]{26}$"
        },
        "provider": {
          "type": "string"
        },
        "action": {
          "type": "string"
        },
        "resource": {
          "type": "string"
        },
        "params_digest": {
          "type": "string"
        },
        "idempotency_key": {
          "type": "string"
        },
        "natural_key": {
          "type": "string"
        },
        "authority": {
          "type": "object",
          "properties": {
            "authority_id": {
              "type": "string",
              "pattern": "^grt_[0-9A-HJKMNP-TV-Z]{26}$"
            },
            "grant_version": {
              "type": "integer"
            },
            "decision_id": {
              "type": "string"
            }
          },
          "required": [
            "authority_id",
            "grant_version",
            "decision_id"
          ],
          "additionalProperties": false
        },
        "state": {
          "type": "string",
          "enum": [
            "REQUESTED",
            "PLANNED",
            "AWAITING_APPROVAL",
            "AUTHORIZED",
            "DENIED",
            "DISPATCHED",
            "EXECUTING",
            "COMMITTED",
            "FAILED",
            "UNCERTAIN",
            "RECONCILING",
            "COMPENSATED",
            "EXPIRED",
            "CANCELLED"
          ]
        },
        "deadline": {
          "type": "string",
          "format": "date-time"
        },
        "attempt": {
          "type": "integer"
        },
        "consequential": {
          "type": "boolean"
        },
        "created_at": {
          "$ref": "#/definitions/Operation/properties/deadline"
        },
        "updated_at": {
          "$ref": "#/definitions/Operation/properties/deadline"
        }
      },
      "required": [
        "v",
        "operation_id",
        "tenant_id",
        "staxion_id",
        "principal_id",
        "principal_epoch",
        "task_id",
        "provider",
        "action",
        "resource",
        "params_digest",
        "idempotency_key",
        "state",
        "deadline",
        "attempt",
        "consequential",
        "created_at",
        "updated_at"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
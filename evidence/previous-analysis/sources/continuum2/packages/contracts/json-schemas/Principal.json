{
  "$ref": "#/definitions/Principal",
  "definitions": {
    "Principal": {
      "type": "object",
      "properties": {
        "v": {
          "type": "number",
          "const": 1
        },
        "principal_id": {
          "type": "string",
          "pattern": "^prn_[0-9A-HJKMNP-TV-Z]{26}$"
        },
        "tenant_id": {
          "type": "string",
          "pattern": "^ten_[0-9A-HJKMNP-TV-Z]{26}$"
        },
        "display_name": {
          "type": "string"
        },
        "owner_user_id": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": [
            "ACTIVE",
            "SUSPENDED",
            "RETIRED"
          ]
        },
        "epoch": {
          "type": "integer",
          "minimum": 0
        },
        "credential_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "v",
        "principal_id",
        "tenant_id",
        "display_name",
        "owner_user_id",
        "status",
        "epoch",
        "credential_ids",
        "created_at"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
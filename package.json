{
  "name": "continuum-safe-implementation",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc",
    "test": "bash tools/run-safe-implementation.sh",
    "scheduler": "node dist/tests/scheduler-comparison.js",

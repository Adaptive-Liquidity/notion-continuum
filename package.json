  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1148.0",
    "@runloop/api-client": "2.0.0",
    "@temporalio/activity": "1.24.0",
    "@temporalio/client": "1.24.0",
    "@temporalio/testing": "1.24.0",
    "@temporalio/worker": "1.24.0",
    "@temporalio/workflow": "1.24.0",
    "ipaddr.js": "2.2.0",
    "jose": "6.1.3",
    "pg": "8.23.1",
    "pg-boss": "12.37.1"
  },
  "devDependencies": {
    "@types/node": "24.19.1",
    "@types/pg": "8.23.1",
    "playwright": "1.58.2",
    "prettier": "3.6.2",
    "typescript": "5.9.3"
  }
}
